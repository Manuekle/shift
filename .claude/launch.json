{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shift",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "docs"
      ],
      "port": 4173
    },
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3005"
      ],
      "port": 3005
    },
    {
      "name": "app-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3006"
      ],
      "port": 3006
    }
  ]
}
